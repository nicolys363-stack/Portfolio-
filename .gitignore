# ==============================================================================
# .gitignore — Portfólio Nicoly Silva
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
ehthumbs.db

# Environment & Secrets (Security Protection)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.secret

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Build & Dependency Artifacts
node_modules/
dist/
build/
.cache/
.parcel-cache/

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary / Scratch Folders
scratch/
tmp/
temp/
