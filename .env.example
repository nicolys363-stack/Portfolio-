# ==============================================================================
# .env.example — Variáveis de Ambiente de Exemplo
# ==============================================================================
# Este projeto é 100% frontend estático e não requer credenciais secretas no cliente.
# Caso adicione integrações futuras (ex: EmailJS, Analytics ou Formspree),
# copie este arquivo para .env e preencha suas chaves privadas.
# ==============================================================================

# Integração de E-mail / Formulário (Opcional para expansões futuras)
# VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
# VITE_EMAILJS_TEMPLATE_ID=seu_template_id_aqui
# VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui

# Configurações do Ambiente
NODE_ENV=production
PORT=8080
